<html>
<head>
<title>ClientExtensionsSamples</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ClientExtensionsSamples</td></tr>
</thead>

<tbody>

<!-- Liferay Sample Custom Element 1 -->

<tr>
	<td>CUSTOM_ELEMENT_1_COUNTER</td>
	<td>css=vanilla-counter>>>.counter</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_ELEMENT_1_DECREMENT_BUTTON</td>
	<td>css=vanilla-counter>>>.decrement</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_ELEMENT_1_INCREMENT_BUTTON</td>
	<td>css=vanilla-counter>>>.increment</td>
	<td></td>
</tr>

<!-- Liferay Sample IFrame 1 -->

<tr>
	<td>IFRAME_1_COUNTER_CART_TOTAL</td>
	<td>//div[contains(@class,'navbar-brand') and contains(.,'Items')]//span[contains(@class,'badge-pill')]</td>
	<td></td>
</tr>
<tr>
	<td>IFRAME_1_COUNTER_INCREMENT_BUTTON</td>
	<td>//button[.//i[contains(@class,'fa-plus-circle')]]</td>
	<td></td>
</tr>

<!-- Liferay Sample Theme Favicon -->

<tr>
	<td>THEME_FAVICON_CONFIGURATION_IMAGE</td>
	<td>//div[contains(@class,'lfr-tooltip-scope')][./input[contains(@name,'favicon')]]//img[@alt='Liferay Sample Theme Favicon']</td>
	<td></td>
</tr>

<!-- Liferay Sample Theme Spritemap 1 -->

<tr>
	<td>THEME_SPRITEMAP_1_PAGE_PENCIL_ICON</td>
	<td>//li[@class='control-menu-nav-item']//*[contains(@href,'/o/liferay-sample-theme-spritemap-1/spritemap.svg#pencil')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>